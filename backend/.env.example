# Copy to .env and fill in. Nothing here has a safe default except the DB path.

# Use Postgres instead of the SQLite file by setting this (Render, Neon, Supabase and
# most hosts call it DATABASE_URL). Leave unset to use the SQLite file below.
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Public base URL, for canonical links, the share image and the sitemap.
# BHOOMI_SITE_URL=https://your-site.example

# Store photographs in the database too. Defaults to on when DATABASE_URL is set,
# because free hosts wipe the disk on every deploy.
# BHOOMI_PHOTOS_IN_DB=1

# Postgres connections kept open per process (keep small on free plans).
# BHOOMI_DB_POOL=5

# Where the SQLite file lives. Relative paths resolve against backend/.
BHOOMI_DB=bhoomi.sqlite3

# Signs the session cookie. Without it, a new key is generated at every startup and
# everyone is logged out when the process restarts.
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BHOOMI_SECRET_KEY=

# Required to read the waitlist over the JSON API (the /admin pages use your
# account instead). Leave unset and those endpoints return 503.
BHOOMI_ADMIN_TOKEN=

# Salt for hashing submitter IPs. We never store raw IPs; the hash is only used
# for rate limiting. Changing it resets rate-limit history.
BHOOMI_IP_SALT=change-me

# Browsers allowed to call the JSON API from another origin. Comma separated.
# Not needed when this app serves the site itself.
BHOOMI_ALLOWED_ORIGINS=

# Waitlist submissions allowed per IP per hour.
BHOOMI_RATE_LIMIT=8

# Fill an empty database with demo accounts, parcels and season plans.
# Turn this off before you put real data in.
BHOOMI_SEED_DEMO=1

# Send the session cookie only over HTTPS. Turn this on in production.
BHOOMI_COOKIE_SECURE=0

# Map background tiles for /karnataka. The default is OpenStreetMap's public server,
# fine for a pilot; heavy traffic should use a provider with its own key and terms.
# {z}/{x}/{y} are filled in by the map. Attribution is shown on the map.
# BHOOMI_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# BHOOMI_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
